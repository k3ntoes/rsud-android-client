# URL Backend RSUD Ajibarang — TEMPLATE
#
# Salin file ini menjadi .env lalu sesuaikan URL server:
#   cp .env.example .env
#
# .env TIDAK di-commit (lihat .gitignore) — perubahan URL lokal tidak
# tercatat di git. Jika .env belum ada, build memakai fallback default
# di app/build.gradle.kts (https://be-ajib.kentoes.my.id/api/).
#
# Wajib:
#   - Diakhiri dengan "/" (Retrofit mewajibkan baseUrl berakhir dengan "/")
#   - Semua endpoint Retrofit memakai path relatif TANPA prefix /api/
#     Contoh: BASE_URL=http://192.168.1.10:8000/api/
#   - Simpan file sebagai UTF-8 tanpa BOM (BOM otomatis di-strip oleh build,
#     tapi lebih aman tanpa BOM).
#
# Setelah edit .env, build ulang: ./gradlew assembleRelease (atau assembleDebug)
BASE_URL=https://be-ajib.kentoes.my.id/api/
